# FLARE config — copy to config.ini and fill in your values.
# After editing: python3 scripts/gen_config.py
# This regenerates firmware/include/tune.h which is compiled into the firmware.
#
# All motor parameters accept a single value (applies to both lanes)
# or a comma-separated list (Lane 1, Lane 2), or a suffixed override. Examples:
#   microsteps: 16              → both lanes use 16
#   microsteps: 16, 32          → Lane 1 = 16, Lane 2 = 32
#   run_current_l1: 0.8         → Lane 1 override (Lane 2 uses global)
#   rotation_distance: 23.0     → both lanes
#   run_current: 0.8, 1.0       → different currents per lane

# ─── Required ────────────────────────────────────────────────────────────────
microsteps:
rotation_distance:
run_current:

# ─── Motor / TMC (per-lane capable) ─────────────────────────────────────────
# full_steps_per_rotation: 200
# gear_ratio: 50:17
# hold_current: 0.980
# dir_invert: 0               # invert motor direction (0/1, comma-list ok)
# interpolate: False
# stealthchop_threshold: 500  # Speed threshold (mm/min) for StealthChop.
#                             # 0 = SpreadCycle always on.
#                             # Non-zero = StealthChop active below this speed.

# ─── TMC Chopper (per-lane capable) ─────────────────────────────────────────
# driver_tbl: 1
# driver_toff: 4
# driver_hstrt: 5
# driver_hend: 3

# ─── Speeds (mm/min) ─────────────────────────────────────────────────────────
# feed_rate: 3000
# rev_rate: 3000
# auto_rate: 3000
# sync_max_rate: 2200
# sync_min_rate: 100
# (buf_stab_rate, pre_ramp_rate, global_max_accel, ramp_tick_ms, sync_ramp_accel,
#  sync_ramp_decel, sync_tick_ms are internal/compile-only — see tune_internal.h)

# ─── Buffer Sync ─────────────────────────────────────────────────────────────
# sync_psf_slew_per_mm: 1500   # type-P feed slew: max sps change per mm filament (lower = gentler; live-tunable via SET)
# sync_psf_filter_mm: 25.0     # type-P feed target EMA length in mm (bigger = smoother; live-tunable via SET)
# baseline_rate: 1600        # starting sync speed (mm/min); set to your print feed rate
# baseline_settle_count: 3
# baseline_variance_reject_frac: 0.15
# baseline_cooldown_ms: 2000
# baseline_cooldown_mm: 5.0
# flow_schedule_cap: 8        # Max generated flow schedule breakpoints (1..16).
#                             # If no table is present, baseline_rate +
#                             # sync_compression_bias_frac become a 1-point schedule.
#
# [flow_schedule.v1]          # Optional, versioned flow-keyed schedule.
#                             # Native firmware units: flow_sps, baseline_sps,
#                             # compression_bias_frac (or bias milli 0..700).
# point0: 6000, 7000, 0.30
# point1: 12000, 13000, 0.40
#
# Return to flat config keys after the optional section:
# [DEFAULT]
# sync_fault_hold_recovery_ms: 5000     # VERIFY: retune from FAULT_HOLD/FAULT_HOLD_RECOVERY event logs
# sync_cannot_refill_mm: 50.0
# sync_cannot_relieve_mm: 50.0
# global_max_rate: 5000         # absolute ceiling for every commanded motor rate (mm/min)
# sync_kp_rate: 900             # rig-validated (2026-05-28): passes autotune at accel=150
# sync_reserve_pct: 35           # Reserve target as % of half the BUF_SWITCH_SPAN toward compression
# sync_auto_stop_ms: 5000          # Auto-mode only: tail-assist timeout in COMPRESSION,
                                   # or normal sync timeout only after COMPRESSION
                                   # recovery has already hit the minimum floor.

# ─── Recommended type-D dynamic-flow config (rig-validated 2026-06-03) ───────
# Copy this block for a type-D buffer that prints with sharp speed steps (e.g.
# slow outer walls ↔ fast infill). It achieves ZERO tension/skip. Trade-off:
# compression-noisy on slow sections (the feed floor overfeeds them to pre-empt
# the step — grind-safe, not a fault). This is the intended type-D behavior;
# quiet + zero-skip simultaneously requires a type-P analog sensor.
#   sync_min_rate: 100       # quiet default. Raising toward the fast-segment rate
#                            #   (~1000) eliminates the slow→fast step skip but
#                            #   overfeeds slow sections into constant clicks (loud
#                            #   zero-skip mode). Slow-drift protection is the
#                            #   compression reserve bias, not this floor.
#   sync_reserve_pct: 65     # compression-side step headroom (cliffs ~70)
#   sync_ramp_accel: 700     # catch step-ups
#   sync_ramp_decel: 700     # drop feed fast on step-downs (cuts compression noise)
#   relay_neutral_frac: 1.0  # demand match — do NOT raise to fight skip
#   sync_est_attack_alpha: 0.8   # fast EST attack on rising demand
#   sync_compression_drain_frac: 0.40   # 0.4 = fuller buffer / more tension margin
# NOTE: sync_min_rate / sync_reserve_pct / sync_ramp_accel / sync_ramp_decel are
# SHARED with type-P. Type-D is the default sensor so these ship as defaults; if
# you run buf_sensor_type=1, review them. (sync_min_rate floors only the type-D
# relay path; type-P psf_control_law is unaffected.)

# ─── Type-D Relay Fallback Law ──────────────────────────────────────────────
# relay_catchup_frac: 1.30            # TENSION refill multiplier in type-D relay mode.
# relay_neutral_frac: 1.00            # NEUTRAL fallback multiplier in type-D relay mode.
                                      # 1.0 = demand match; switches are guardrails.
                                      # Raise slightly only if it drifts to TENSION.
# sync_compression_drain_frac: 0.40   # Type-D COMPRESSION active-draw drain; 0.0 = legacy hard-stop.
# sync_compression_drain_budget_mm: 3.0  # Stop partial drain after this much COMPRESSION relieve effort;
                                        # 0.0 = immediate hard-stop.
# sync_est_attack_alpha: 0.8       # Type-D rising-demand EST attack; clamp 0.65..1.0.
# sync_tension_fast_mm_s: 2.0      # Type-D TENSION crossing velocity for full EST snap.
# sync_tension_recovery_floor: 2400 # Type-D decaying NEUTRAL feed floor after TENSION touch;
                                    # mm/min, 0 disables, clamp 0..6000.
# sync_tension_recovery_ms: 1500    # Recovery-floor decay window; clamp 0..10000.
# sync_relay_trim_step_sps: 300       # Type-D residual trim step; lower = slower correction,
                                      # rarer plateau clicks.
# sync_relay_trim_clamp_sps: 2000     # Type-D residual trim anti-windup clamp.

# ─── Trailing-Bias Setpoint Shift ────────────────────────────────────────────
# sync_compression_bias_frac: 0.45  # additional setpoint shift toward compression.
                                 # 0.0 = legacy behavior (SYNC_RESERVE_PCT only).
                                 # 0.4 typical for slow-extrusion soak; 0.7 max.

# ─── Internal control-loop constants (NOT user-tunable) ──────────────────────
# Integral centering, estimator confidence/sigma, drift observer + TENSION-risk
# telemetry, relay-collapse law, relay_min_flip (BLOCKED at 0.0), neutral-creep,
# variance blend, est/zone-bias, EWMA alphas, debounce/predict windows, and
# similar control-loop internals are no longer config keys. They live as
# constants in firmware/include/tune_internal.h — edit there + rebuild. A
# -DFLARE_DEV_TUNING build re-exposes them as ephemeral (non-persisted) SET:
# overrides for bench experimentation. See the tier-config-surface change.

# ─── Cutter / Servo ──────────────────────────────────────────────────────────
# enable_cutter: False
# unload_cut: False
# servo_open_us: 500
# servo_close_us: 1400
# servo_block_us: 950
# servo_settle_ms: 500
# cut_feed_rate: 1500
# cut_feed_mm: 150
# cut_length_mm: 10
# cut_amount: 1

# ─── Watchdog timeouts ───────────────────────────────────────────────────────
# Toolchange (cut/toolhead/Y), cutter (feed/settle), and RELOAD-Y watchdogs are
# internal constants in firmware/include/tune_internal.h, padded for worst-case
# slow hardware. Not user-tunable; -DFLARE_DEV_TUNING exposes them ephemerally.

# ─── Safety / Limits ─────────────────────────────────────────────────────────
# load_max_mm: 3000           # Max distance for toolhead load
# autoload_retract_mm: 5      # Retract distance after LO: triggers OUT and after UL: clears OUT; 0 = stop immediately
# unload_max_mm: 3000         # Max distance for unloads
# unload_tension_block_ms: 5000   # Stop UL if buffer stays TENSION this long (printer blocking); 0 = disabled
# autoload_max_mm: 600        # Max distance for preload to OUT
# runout_cooldown_ms: 12000

# ─── Flow Control ────────────────────────────────────────────────────────────
# auto_mode: True             # Enable automated flow (auto-sync, toolhead load)
# auto_preload: True          # Enable parking preload on insertion

# ─── Physical Model (mm) ─────────────────────────────────────────────────────
# dist_in_out: 150            # Distance between IN and OUT sensors
# dist_out_y: 100             # Distance from OUT sensor to Y-splitter
# dist_y_buf: 300             # Distance from Y-splitter to buffer entry
# buf_body_len: 200           # Total physical length of buffer body
# buf_switch_span_mm: 10       # Full switch-to-switch sensing span
# buf_max_travel_mm: 25       # Full mechanical buffer travel

# ─── Sync-Feedback Sensor ─────────────────────────────────────────────────────
# Happy Hare types: D=0 (Dual two-switch), P=1 (Proportional analog).
# TO/CO are recognized type names but are not implemented in FLARE.
# buf_sensor_type: 0
# buf_home_state: 0           # Buffer resting/homing state when unloaded: 0=NEUTRAL, 1=TENSION, 2=COMPRESSION
# buf_psf_max_comp: 1.0
# buf_psf_max_tens: 0.0
# buf_psf_neutral: 0.5
# buf_psf_goal: 0.7
# buf_analog_alpha: 0.20

# ─── TS Fallback ─────────────────────────────────────────────────────────────
# ts_buf_fallback_ms: 2000

# ─── Reload Mode ─────────────────────────────────────────────────────────────
# reload_mode: 1              # Enable autonomous swap on runout
# reload_join_delay_ms: 10000 # extra wait after tail/Y clear before JOINING

# ─── RELOAD Tuning ───────────────────────────────────────────────────────────
# compression_rate: 90           # coasting speed when buffer is stalled
# join_rate: 1600             # fast approach speed
# press_rate: 1200            # top speed in follow-sync
# reload_touch_settle_ms: 120 # brief settle after tail-to-tip touch
# reload_touch_boost_ms: 900  # boosted push window after settle
# reload_touch_floor_pct: 90  # min % of PRESS_RATE during boost window
# follow_timeout_ms: 10000    # max time in follow before error
