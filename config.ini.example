# FLARE config — copy to config.ini and fill in your values.
# After editing: python3 scripts/gen_config.py
# This regenerates firmware/include/tune.h which is compiled into the firmware.
#
# All motor parameters accept a single value (applies to both lanes)
# or a comma-separated list (Lane 1, Lane 2), or a suffixed override. Examples:
#   microsteps: 16              → both lanes use 16
#   microsteps: 16, 32          → Lane 1 = 16, Lane 2 = 32
#   run_current_l1: 0.8         → Lane 1 override (Lane 2 uses global)
#   rotation_distance: 23.0     → both lanes
#   run_current: 0.8, 1.0       → different currents per lane

# ─── Required ────────────────────────────────────────────────────────────────
microsteps:
rotation_distance:
run_current:

# ─── Motor / TMC (per-lane capable) ─────────────────────────────────────────
# full_steps_per_rotation: 200
# gear_ratio: 50:17
# hold_current: 0.980
# dir_invert: 0               # invert motor direction (0/1, comma-list ok)
# interpolate: False
# stealthchop_threshold: 500  # Speed threshold (mm/min) for StealthChop.
#                             # 0 = SpreadCycle always on.
#                             # Non-zero = StealthChop active below this speed.

# ─── TMC Chopper (per-lane capable) ─────────────────────────────────────────
# driver_tbl: 1
# driver_toff: 4
# driver_hstrt: 5
# driver_hend: 3

# ─── Speeds (mm/min) ─────────────────────────────────────────────────────────
# feed_rate: 3000
# rev_rate: 3000
# auto_rate: 3000
# buf_stab_rate: 600         # stabilization speed (boot + UL tension recovery)
# sync_max_rate: 2200
# sync_min_rate: 100
# pre_ramp_rate: 90

# ─── Motion / Ramp ───────────────────────────────────────────────────────────
# motion_startup_ms: 1000
# ramp_step_rate: 17.1
# ramp_tick_ms: 5

# ─── Buffer Sync ─────────────────────────────────────────────────────────────
# buf_hyst_ms: 30
# sync_ramp_up_rate: 40
# sync_ramp_dn_rate: 80
# sync_tick_ms: 20
# baseline_rate: 1600        # starting sync speed (mm/min); set to your print feed rate
# baseline_alpha: 0.02
# baseline_settle_count: 3
# baseline_variance_reject_frac: 0.15
# baseline_cooldown_ms: 2000
# baseline_cooldown_mm: 5.0
# flow_schedule_cap: 8        # Max generated flow schedule breakpoints (1..16).
#                             # If no table is present, baseline_rate +
#                             # sync_compression_bias_frac become a 1-point schedule.
#
# [flow_schedule.v1]          # Optional, versioned flow-keyed schedule.
#                             # Native firmware units: flow_sps, baseline_sps,
#                             # compression_bias_frac (or bias milli 0..700).
# point0: 6000, 7000, 0.30
# point1: 12000, 13000, 0.40
#
# Return to flat config keys after the optional section:
# [DEFAULT]
# sync_fault_hold_recovery_ms: 5000     # VERIFY: retune from FAULT_HOLD/FAULT_HOLD_RECOVERY event logs
# sync_cannot_refill_mm: 50.0
# sync_cannot_relieve_mm: 50.0
# buf_predict_thr_ms: 250
# global_max_rate: 4000         # absolute ceiling for every commanded motor rate (mm/min)
# sync_kp_rate: 900
# sync_overshoot_pct: 150        # Trailing-side trim as % of sync correction (0..200)
# sync_reserve_pct: 35           # Reserve target as % of half the BUF_SWITCH_SPAN toward compression
# sync_auto_stop_ms: 5000          # Auto-mode only: tail-assist timeout in COMPRESSION,
                                   # or normal sync timeout only after COMPRESSION
                                   # recovery has already hit the minimum floor.
# post_print_stab_delay_ms: 0      # Legacy name: idle compression negative-sync delay.
                                   # 0 = start immediately when idle+COMPRESSION.
# sync_tension_dwell_stop_ms: 6000 # Hard stop if continuously pinned at tension endstop
                                   # for this many ms. 0 = disable.
# sync_tension_ramp_delay_ms: 0    # Disable estimator-bypass refill ramp; TENSION_STOP
                                   # remains the hard guard for real tension pins.
# sync_overshoot_neutral_extend: 1     # Extend compression overshoot trim into BUF_NEUTRAL when
                                   # reserve is below deadband.

# ─── Integral Centering + Estimator Confidence ───────────────────────────
# sync_reserve_integral_gain: 0.0  # I-gain (mm of target bias per mm·s of reserve error).
                                   # 0.0 = feature disabled (default). Enable with
                                   # a small value (e.g. 0.005) after
                                   # reviewing soak-run data.
# sync_reserve_integral_clamp_mm: 0.6  # Hard clamp on the integral correction in mm.
                                       # Cannot exceed buf_virtual_deadband_mm() in practice.
# sync_reserve_integral_decay_ms: 0    # Reserved for future use; 0 = hold integral while frozen.
# est_sigma_hard_cap_mm: 1.5           # Confidence drops to 0 when estimator sigma reaches this.
                                       # Approximates physical buffer half-travel.
# est_low_cf_warn_threshold: 0.5       # EV:BUF,EST_LOW_CF fires when confidence < this.
# est_fallback_cf_threshold: 0.2       # Integral freezes when confidence < this.

# ─── Type-D Relay Fallback Law ──────────────────────────────────────────────
# relay_catchup_frac: 1.30            # TENSION refill multiplier in type-D relay mode.
# relay_neutral_frac: 1.25            # NEUTRAL fallback/lean multiplier in type-D relay mode.
# relay_min_flip_mm: 0.0              # Distance hysteresis for relay flips; 0.0 keeps time-only.
                                     # NON-ZERO BLOCKED: gating a flip on the actuator's own motor
                                     # travel deadlocks any flip whose acceptance is what starts the
                                     # motion (COMPRESSION egress AND the cold NEUTRAL->TENSION
                                     # catch-up entry). Needs the G2 redesign (guard only the
                                     # calming/exit flips, never corrective entry / zero-feed
                                     # egress) or drop motion-hysteresis. See design G2.
# relay_collapse_delay_ms: 250        # Delay before deep-COMPRESSION collapse ramp engages.
# relay_collapse_ramp_mult: 3         # Down-ramp multiplier after collapse delay.
# relay_collapse_cap_ms: 600          # Max collapse ramp window.

# ─── Drift Observer & TENSION-Risk Telemetry ─────────────────────────────────
# buf_drift_ewma_tau_ms: 60000        # EWMA time constant for per-transition residual drift (ms).
#                                     # Longer = more stable estimate; shorter = faster adaptation.
# buf_drift_min_samples: 3            # Samples before full correction; enabled correction ramps in earlier.
# buf_drift_apply_thr_mm: 2.0         # Provisional correction threshold in mm; 0.0 disables correction.
#                                     # Raise/lower after observing stable BPD convergence in real prints.
# buf_drift_clamp_mm: 3.0             # Provisional hard clamp on applied correction magnitude in mm (runtime max 8.0).
# buf_drift_apply_min_cf: 0.5         # Min estimator confidence (EC:/100) required to apply correction.
# tension_risk_window_ms: 60000           # Rolling window for TENSION-pin density warning (runtime-only).
# tension_risk_threshold: 4               # EV:SYNC,TENSION_RISK_HIGH fires when pin count >= this (runtime-only).

# ─── Trailing-Bias Setpoint Shift & Adaptive Sync ───────────────────────────
# sync_compression_bias_frac: 0.4   # additional setpoint shift toward compression.
                                 # 0.0 = legacy behavior (SYNC_RESERVE_PCT only).
                                 # 0.4 typical for slow-extrusion soak; 0.7 max.
# neutral_creep_timeout_ms: 4000     # Neutral-dwell wait before creep activates (ms). 0 disables.
# neutral_creep_rate_sps_per_s: 5    # Creep ramp slope. 0 disables.
# neutral_creep_cap_frac: 10         # Hard cap on creep as percentage of extruder_est_sps.
# buf_variance_blend_frac: 0.5   # Max variance-aware blend fraction (0.0=OFF, 0.5 typical).
# buf_variance_blend_ref_mm: 1.0 # Sigma value at which blend distrust saturates.

# ─── Smarter Sync (Estimator) ────────────────────────────────────────────────
# est_alpha_min: 0.12          # Estimator responsiveness (slow drifts)
# est_alpha_max: 0.65          # Estimator responsiveness (sharp jumps)
# zone_bias_base_rate: 90      # Base reserve-recovery correction (mm/min)
# zone_bias_ramp_rate: 30      # Reserve-recovery ramp (mm/min per second stuck in zone)
# zone_bias_max_rate: 600      # Max reserve-recovery correction (mm/min)
# reload_lean_factor: 1.15     # RELOAD follow over-feed factor (0.0 to 5.0)

# ─── Cutter / Servo ──────────────────────────────────────────────────────────
# enable_cutter: False
# unload_cut: False
# servo_open_us: 500
# servo_close_us: 1400
# servo_block_us: 950
# servo_settle_ms: 500
# cut_feed_timeout_ms: 30000
# cut_settle_timeout_ms: 3000
# cut_feed_rate: 1500
# cut_feed_mm: 150
# cut_length_mm: 10
# cut_amount: 1

# ─── Toolchange Timeouts ─────────────────────────────────────────────────────
# tc_timeout_cut_ms: 5000
# tc_timeout_th_ms: 3000
# tc_timeout_y_ms: 5000

# ─── Safety / Limits ─────────────────────────────────────────────────────────
# load_max_mm: 3000           # Max distance for toolhead load
# autoload_retract_mm: 5      # Retract distance after LO: triggers OUT and after UL: clears OUT; 0 = stop immediately
# unload_max_mm: 3000         # Max distance for unloads
# unload_tension_block_ms: 5000   # Stop UL if buffer stays TENSION this long (printer blocking); 0 = disabled
# autoload_max_mm: 600        # Max distance for preload to OUT
# runout_cooldown_ms: 12000

# ─── Flow Control ────────────────────────────────────────────────────────────
# auto_mode: True             # Enable automated flow (auto-sync, toolhead load)
# auto_preload: True          # Enable parking preload on insertion

# ─── Physical Model (mm) ─────────────────────────────────────────────────────
# dist_in_out: 150            # Distance between IN and OUT sensors
# dist_out_y: 100             # Distance from OUT sensor to Y-splitter
# dist_y_buf: 300             # Distance from Y-splitter to buffer entry
# buf_body_len: 200           # Total physical length of buffer body
# buf_switch_span_mm: 10       # Full switch-to-switch sensing span
# buf_max_travel_mm: 25       # Full mechanical buffer travel

# ─── Sync-Feedback Sensor ─────────────────────────────────────────────────────
# Happy Hare types: D=0 (Dual two-switch), P=1 (Proportional analog).
# TO/CO are recognized type names but are not implemented in FLARE.
# buf_sensor_type: 0
# buf_analog_neutral: 0.5
# buf_range: 0.45
# buf_thr: 0.30
# buf_analog_alpha: 0.20

# ─── TS Fallback ─────────────────────────────────────────────────────────────
# ts_buf_fallback_ms: 2000

# ─── Reload Mode ─────────────────────────────────────────────────────────────
# reload_mode: 1              # Enable autonomous swap on runout
# reload_y_timeout_ms: 10000  # max wait for Y to clear during RELOAD
# reload_join_delay_ms: 10000 # extra wait after tail/Y clear before JOINING

# ─── RELOAD Tuning ───────────────────────────────────────────────────────────
# compression_rate: 90           # coasting speed when buffer is stalled
# join_rate: 1600             # fast approach speed
# press_rate: 1200            # top speed in follow-sync
# reload_touch_settle_ms: 120 # brief settle after tail-to-tip touch
# reload_touch_boost_ms: 900  # boosted push window after settle
# reload_touch_floor_pct: 90  # min % of PRESS_RATE during boost window
# follow_timeout_ms: 10000    # max time in follow before error
